###################################
#Debup - GitHub DEB Package Manager
###################################

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m'

CONF_DIR="/etc/debup"
SOURCES_FILE="${CONF_DIR}/sources.list"

ARCH=$(dpkg --print-architecture 2>/dev/null || echo "amd64")

if grep-qi "ubuntu" /etc/os-release 2>/dev/null; then
DISTRO_PREF="ubuntu"
else
DISTRO_PREF="debian"
fi

if [ ! -d "$CONF_DIR" ]; then
sudo mkdir -p "$CONF_DIR" 2>/dev/null || sudo mkdir -p "$CONF_DIR"
fi

if [ ! -f "$SOURCES_FILE" ]; then
touch "$SOURCES_FILE" 2>/dev/null || sudo touch "$SOURCES_FILE"
chmod 644 "$SOURCES_FILE" || sudo chmod 644 "$SOURCES_FILE"
fi

if [ -z "$GITHUB_TOKEN" ] && [ -f "$CONF_DIR/debup.conf" ]; then
GITHUB_TOKEN=$(grep -E '^GITHUB_TOKEN=' "$CONF_DIR/debup.conf" | cut -d'=' -f2- | tr -d '"'\''')
fi

AUTH_HEADER=()
if [ -n "$GITHUB_TOKEN" ]; then
AUTH_HEADER=(-H "Authorization: Bearer $GITHUB_TOKEN")
fi

set_github_token() {
local token="$1"

if [ -z "$token" ]; then
echo -en "${CYAN}Enter your GitHub Personal Access Token (PAT): ${NC}"
read -rs token </dev/tty
echo ""
fi

if [ -z "$token" ]; then
echo -e "${RED}[X] Error: Token cannot be empty.${NC}"
return 1
fi

local shell_rc="$HOME/.bashrc"
if [ -n "$ZSH_VERSION" ] || [ "$SHELL" = "*/zsh" ]; then
shell_rc="$HOME/.zshrc"
fi

if [ -f "$shell_rc" ]; then
sed -i '/export GITHUB_TOKEN=/d' "$shell_rc"
fi

echo "export GITHUB_TOKEN=\"$token\"" >> "$shell_rc"

if [ -w "$CONF_DIR" ] || [ "$EUID" -eq 0 ]; then
mkdir -p "$CONF_DIR"
echo "GITHUB_TOKEN=\"$token\"" > "$CONF_DIR/debup.conf"
chmod 600 "$CONF_DIR/debup.conf"
fi

echo -e "${GREEN}[✓] GITHUB_TOKEN configured successfully!"
echo -e "${YELLOW}[!] To apply it immediately to the current terminal session, run:${NC}"
echo "   export GITHUB_TOKEN=\"$token\""
echo "   (Or reload your shell: source $shell_rc)"
}

check_and_update() {
local REPO_URL="$1"
local PKG_NAME="$2"
local ASSUME_YES="$3"

local api_url
if [[ "$REPO_URL" == *"api.github.com"* ]]; then
api_url="${REPO_URL%/}/releases/latest"
else
local repo_path
repo_path=$(echo "$REPO_URL" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
api_url="https://api.github.com/repos/${repo_path}/releases/latest"
fi

local release_json
release_json=$(curl -sSL \
"${AUTH_HEADER[@]}" \
-H "Accept:application/vnd.github+json" \
-H "User-Agent: debup" \
"$api_url")

local latest_tag
latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')

if [ -z "$latest_tag" ]; then
local error_message
error_message=$(echo "$release_json" | jq -r '.message // empty' 2>/dev/null)

printf "%b\n" "${BLUE}---------------------------------------${NC}"
echo "${RED}[X] Error: Unable to fetch release info for ${repo_path:-$REPO_URL}.${NC}"

if [ -n "$error_message" ]; then
printf "%b\n" "${RED}[X] GitHub API response: ${error_message}${NC}"
fi
return 1
fi

local remote_ver="${latest_tag#v}"

local local_ver=""
if [ -n "$PKG_NAME" ]; then
local_ver=$(dpkg-query -W -f='${Version}' "$PKG_NAME" 2>/dev/null | tr -d '\r')
fi
local_ver="${local_ver#v}"

printf "%b\n" "==> Package: ${PKG_NAME:-New package} (${repo_path:-$REPO_URL})"
printf "%b\n" "${CYAN}Current version:${NC} ${local_ver:-Not installed}"
printf "%b\n" "${GREEN}Latest version:${NC}  ${remote_ver}"

if [ -n "$local_ver" ] && dpkg --compare-versions "$local_ver" ge "$remote_ver"; then
printf "%b\n" "${GREEN}[✓] Package is already up to date!${NC}"
return 0
fi

local candidate_urls
candidate_urls=$(echo "$release_json" | jq -r --arg arch "$ARCH" '.assets[] | select((.name | endswith(".deb")) and (.name | test($arch + "|all"; "i"))) | .browser_download_url')

local deb_url=""
if [ -n "$candidate_urls" ]; then
deb_url=$(echo "$candidate_urls" | grep -i "$DISTRO_PREF" | head -n1)
if [ -z "$deb_url" ]; then
deb_url=$(echo "$candidate_urls" | head -n1)
fi
fi

if [ -z "$deb_url" ] || [ "$deb_url" = "null" ]; then
deb_url=$(echo "$release_json" | jq -r '.assets[] | select(.name | test("\\.deb$")) | .browser_download_url' | head -n1)
fi

if [ -z "$deb_url" ] || [ "$deb_url" = "null" ]; then
printf "%b\n" "${BLUE}---------------------------------------${NC}"
printf "%b\n" "${RED}[!] New version found (${latest_tag}), but no suitable .deb asset is available.${NC}"
return 1
fi

if [ "$ASSUME_YES" != "true" ]; then
printf "%b\n" "${YELLOW}[?] Do you want to download and install it? [y/N]:${NC}"
read -r confirm </dev/tty
if [[ ! "$confirm" =~ ^[yY]$ ]]; then
echo "${RED}[X] Operation canceled.${NC}"
return 0
fi
fi

local tmp_deb="/tmp/debup_${remote_ver}_${ARCH}.deb"
trap 'rm -f "$tmp_deb"' INT TERM EXIT

printf "%b\n" "${CYAN}[*] Downloading: ${deb_url}${NC}"
if ! curl -L --progress-bar -o "$tmp_deb" "$deb_url"; then
printf "%b\n" "${RED}[X] Download failed.${NC}\n"
rm -f "$tmp_deb"
return 1
fi

if [ -z "$PKG_NAME" ]; then
PKG_NAME=$(dpkg-deb -f "$tmp_deb" Package 2>/dev/null || true)
fi

printf "%b\n" "${CYAN}[*] Installing package (sudo required)...${NC}"
if sudo apt-get install -y "$tmp_deb"; then
rm -f "$tmp_deb"
printf "%b\n" "${GREEN}[✓] Successfully installed/updated ${PKG_NAME} (${latest_tag})!${NC}\n"

if [ -n "$PKG_NAME" ] && ! grep -q "^${PKG_NAME}|" "$SOURCES_FILE" 2>/dev/null; then
echo "${PKG_NAME}|${REPO_URL}" | sudo tee -a "$SOURCES_FILE" >/dev/null
fi
return 0
else
printf "%b\n" "${RED}[X] Installation failed.${NC}\n"
rm -f "$tmp_deb"
return 1
fi
}

debup_search() {
local query="$1"
if [ -z "$query" ]; then
echo -e "${RED}[!] Error:${NC} Usage: debup search <tool_name>"
return 1
fi

echo -e "${BLUE}::${NC} ${CYAN}Searching for '$query' on GitHub...${NC}"

local results
results=$(curl -s "${AUTH_HEADER[@]}" \
"https://api.github.com/search/repositories?q=${query}+in:name&sort=stars&order=desc&per_page=5")

local count
count=$(echo "$results" | jq -r '.items | length' 2>/dev/null)

if [ -z "$count" ] || [ "$count" -eq 0 ]; then
echo-e "${YELLOW}[!] No repositories found for '$query'.${NC}"
return 1
fi

echo -e "\n${GREEN}Repositories found:${NC}"
echo -e "${CYAN}---------------------------------------------------------${NC}"

local repos=()
local i=1

while IFS=$'\t' read -r repo stars desc; do
repos+=("$repo")
printf " ${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${YELLOW}★ %-6s${NC}\n     ${GRAY}%s${NC}\n" \
"$i" "$repo""$stars" "${desc:-No description provided}"
((i++))
done < <(echo "$results"| jq -r '.items[] |[.full_name, (.stargazers_count|tostring), (.description // "")] | @tsv')

echo -e "${CYAN}---------------------------------------------------------${NC}"

local choice
read -rp "Select a package to install [1-$count] (Press Enter to cancel): " choice

if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
local selected_repo="${repos[$((choice - 1))]}"
echo -e "\n${CYAN}:: Inspecting latest release assets for${NC} ${GREEN}$selected_repo${NC}..."

local release_data
release_data=$(curl -s "${AUTH_HEADER[@]}" "https://api.github.com/repos/${selected_repo}/releases/latest")

local deb_assets
deb_assets=$(echo "$release_data" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$')

if [ -z "$deb_assets" ]; then
echo -e "${RED}[X] Error: No .deb packages found in the latest release of this repository.${NC}"
echo "${CYAN}Cannot install via debup.${NC}"
return 1
fi

local matching_deb
matching_deb=$(echo "$deb_assets" | grep -iE "(${ARCH}|all|_all)")

if [ -n "$matching_deb" ]; then
local pref_deb
pref_deb=$(echo "$matching_deb" | grep -i "$DISTRO_PREF" | head -n1)
matching_deb="${pref_deb:-$(echo "$matching_deb" | head -n1)}"
fi

if [ -z "$matching_deb" ]; then
echo -e "${YELLOW}[!] Warning: .deb packages exist, but none seem to match your architecture ($ARCH).${NC}"
read -rp "Do you still want to proceed with the installation? [y/N]: " force_install
if [[ ! "$force_install" =~ ^[yY]$ ]]; then
echo -e "${CYAN}Installation cancelled.${NC}"
return0
fi
fi

echo -e "${GREEN}[✓] Compatible package detected. Adding repository...${NC}"
check_and_update "$selected_repo" "" false
else
echo -e "${CYAN}Operation cancelled.${NC}"
fi
}

case "$1" in
add|install)
shift
ASSUME_YES="false"
REPO=""
while [ "$#" -gt 0 ]; do
case "$1" in
-y|--yes) ASSUME_YES="true" ;;
*) REPO="$1" ;;
esac
shift
done
[ -z "$REPO" ] && { echo "Usage: debup add|install [-y] <owner/repo | github_url>"; >&2 exit 1; }
check_and_update "$REPO" "" "$ASSUME_YES"
;;

update|upgrade)
shift
ASSUME_YES="false"
while [ "$#" -gt 0 ]; do
case "$1" in
-y|--yes) ASSUME_YES="true" ;;
esac
shift
done

if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
echo -e "${YELLOW}[!] No packages managed by debup yet.${NC}"
exit 0
fi

while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
[[ "$pkg" =~ ^#.* ]] && continue
[ -z "$pkg" ] && continue
check_and_update "$repo" "$pkg" "$ASSUME_YES"
echo ""
done < "$SOURCES_FILE"
;;

list)
if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
echo "${YELLOW}[!] No packages registered.${NC}"
exit 0
fi
printf "%-25s %s\n" "PACKAGE"      "REPOSITORY"
printf "%-25s %s\n" "-------"      "----------"
while IFS='|' read -r pkg repo || [ -n "$pkg" ];do
[[ "$pkg" =~ ^#.* ]] && continue
[ -z "$pkg" ] && continue
printf "%-25s %s\n" "$pkg" "$repo"
done < "$SOURCES_FILE"
;;

remove)
PKG="$2"
[ -z "$PKG" ] && { echo "${YELLOW}[!] Usage: debup remove${NC} <package_name>"; exit 1; }
if [ -f "$SOURCES_FILE" ]; then
sudo sed -i "/^${PKG}|/d" "$SOURCES_FILE"
printf "%b\n" "${GREEN}[✓] ${PKG} removed from debup tracking.${NC}"
fi
read -rp "Do you also want to purge the package from the system using apt?[y/N]: " del_sys </dev/tty
if [[ "$del_sys" =~ ^[yY]$ ]]; then
sudo apt-get remove --purge -y "$PKG"
fi
;;

token|auth|ghtoken)
shift
set_github_token "$1"
;;

search)
shift
debup_search "$1"
;;

help|--help|-h|"")
echo -e "${CYAN}debup${NC} - GitHub Releases .deb Package Manager"
echo ""
echo "Usage: debup <command> [arguments]"
echo ""
echo "Commands:"
echo "  search <query>             Search GitHub repositories and install interactively"
echo "  add, install [-y] <repo>   Install package from owner/repo or GitHub URL"
echo "  update, upgrade [-y]       Update all tracked packages"
echo "  list                       List all trackedpackages"
echo "  remove <pkg>               Stop tracking (and optionally purge) a package"
echo "  auth, token [PAT]          Configure GitHub Personal Access Token"
echo "  help                       Show this help message"
;;

*)
echo -e "${RED}[X] Unknown command: $1${NC}"
echo "Run 'debup help' for usage instructions."
exit 1
;;
esac
