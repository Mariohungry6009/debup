###################################
#Debup - GitHub DEB Package Manager
###################################

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

CONF_DIR="/etc/debup"
SOURCES_FILE="${CONF_DIR}/sources.list"
ARCH=$(dpkg --print-architecture 2>/dev/null || echo "amd64")

init_storage() {
if [ ! -d "$CONF_DIR" ]; then
sudo mkdir -p "$CONF_DIR"
fi
if [ ! -f "$SOURCES_FILE" ]; then
sudo touch "$SOURCES_FILE"
sudo chmod 644 "$SOURCES_FILE"
fi
}

check_and_update() {
local REPO_URL="$1"
local PKG_NAME="$2"
local ASSUME_YES="$3"

local api_url
if [[ "$REPO_URL" == *"api.github.com"* ]]; then
api_url="${REPO_URL%/}/releases/latest"
else
local repo_path
repo_path=$(echo "$REPO_URL" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
api_url="https://api.github.com/repos/${repo_path}/releases/latest"
fi

local release_json
release_json=$(curl -sSL \
-H "Accept: application/vnd.github+json" \
-H "User-Agent: debup" \
"$api_url")

local latest_tag
latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')

if [ -z "$latest_tag" ]; then
local error_message
error_message=$(echo "$release_json" | jq -r '.message // empty' 2>/dev/null)

printf "%b\n" "${BLUE}---------------------------------------${NC}"
printf "%b\n" "${RED}[X] Error: Unable to fetch release info for ${repo_path:-$REPO_URL}.${NC}"

if [ -n "$error_message" ]; then
printf "%b\n" "${RED}[X] GitHub APIresponse: ${error_message}${NC}"
fi
return 1
fi

local remote_ver="${latest_tag#v}"

local local_ver=""
if [ -n "$PKG_NAME" ]; then
local_ver=$(dpkg-query -W -f='${Version}' "$PKG_NAME" 2>/dev/null | tr -d '\r')
fi
local_ver="${local_ver#v}"

printf "%b\n" "${BLUE}==>${NC} Package: ${CYAN}${PKG_NAME:-New package}${NC} (${repo_path:-$REPO_URL})"
printf "%b\n" "${YELLOW}Current version:${NC} ${local_ver:-Not installed}"
printf "%b\n" "${GREEN}Latest version:${NC}  ${remote_ver}"

if [ -n "$local_ver" ] && [ "$local_ver" = "$remote_ver" ]; then
printf "%b\n" "${GREEN}[✓] Package is already up to date!${NC}\n"
return 0
fi

local deb_url
deb_url=$(echo "$release_json" | jq -r --arg arch "$ARCH" '.assets[] | select((.name | endswith(".deb")) and (.name | test($arch + "|all"; "i"))) | .browser_download_url' | head -n1)

if [ -z "$deb_url" ] || [ "$deb_url" = "null" ]; then
deb_url=$(echo "$release_json" | jq -r '.assets[] | select(.name | test("\\.deb$")) | .browser_download_url' | head -n1)
fi

if [ -z "$deb_url" ] || [ "$deb_url" = "null" ]; then
printf "%b\n" "${BLUE}---------------------------------------${NC}"
printf "%b\n" "${RED}[!] New version found (${latest_tag}), but no suitable .deb asset is available.${NC}\n"
return 1
fi

if [ "$ASSUME_YES" != "true" ]; then
printf "%b" "${YELLOW}[?] Do you want to download and install it? [y/N]: ${NC}"
read -r confirm
if [[ ! "$confirm" =~ ^[yY]$ ]]; then
printf "%b\n" "${RED}[X] Operation canceled.${NC}\n"
return 0
fi
fi

local tmp_deb="/tmp/debup_${remote_ver}_${ARCH}.deb"

printf "%b\n" "${CYAN}[*] Downloading: ${deb_url}${NC}"
if ! curl -L --progress-bar -o "$tmp_deb" "$deb_url"; then
printf "%b\n" "${RED}[X] Download failed.${NC}\n"
rm -f "$tmp_deb"
return 1
fi

if [ -z "$PKG_NAME" ]; then
PKG_NAME=$(dpkg-deb -f "$tmp_deb" Package 2>/dev/null || true)
fi

printf "%b\n" "${CYAN}[*] Installing package (sudo required)...${NC}"
if sudo apt-get install -y "$tmp_deb"; then
rm -f "$tmp_deb"
printf "%b\n" "${GREEN}[✓] Successfully installed/updated ${PKG_NAME} (${latest_tag})!${NC}\n"

init_storage
if [ -n "$PKG_NAME" ] && ! grep -q "^${PKG_NAME}|" "$SOURCES_FILE" 2>/dev/null; then
echo "${PKG_NAME}|${REPO_URL}" | sudo tee -a "$SOURCES_FILE" >/dev/null
fi
return 0
else
printf "%b\n" "${RED}[X] Installation failed.${NC}\n"
rm -f "$tmp_deb"
return 1
fi
}

# --- CLI ROUTER ---
case "$1" in
add|install)
shift
ASSUME_YES="false"
REPO=""
while [ "$#" -gt 0 ]; do
case "$1" in
-y|--yes) ASSUME_YES="true" ;;
*) REPO="$1" ;;
esac
shift
done
[ -z "$REPO" ] && { echo "Usage: debup add|install [-y] <owner/repo | github_url>"; exit 1; }
check_and_update "$REPO" "" "$ASSUME_YES"
;;

update|upgrade)
shift
ASSUME_YES="false"
while [ "$#" -gt 0 ]; do
case "$1" in
-y|--yes) ASSUME_YES="true" ;;
esac
shift
done

if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
echo "No packages managed by debup yet."
exit 0
fi

while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
[[ "$pkg" =~ ^#.* ]] && continue
[ -z "$pkg" ] && continue
check_and_update "$repo" "$pkg" "$ASSUME_YES"
echo ""
done < "$SOURCES_FILE"
;;

list)
if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
echo "No packages registered."
exit 0
fi
printf "%-25s %s\n" "PACKAGE" "REPOSITORY"
printf "%-25s %s\n" "-------" "----------"
while IFS='|' read -r pkg repo || [ -n "$pkg" ];do
[[ "$pkg" =~ ^#.* ]] && continue
[ -z "$pkg" ] && continue
printf "%-25s %s\n" "$pkg" "$repo"
done <"$SOURCES_FILE"
;;

remove)
PKG="$2"
[ -z "$PKG" ] && { echo "Usage: debup remove <package_name>"; exit 1; }
if [ -f "$SOURCES_FILE" ]; then
sudo sed -i "/^${PKG}|/d" "$SOURCES_FILE"
printf "%b\n" "${GREEN}[✓] ${PKG} removed from debup tracking.${NC}"
fi
read -rp "Do you also want to purge the package from the system using apt?[y/N]: " del_sys
if [[ "$del_sys" =~ ^[yY]$ ]]; then
sudo apt-get remove --purge -y "$PKG"
fi
;;

help|--help|-h|*)
echo "Debup - GitHub DEB Package Manager"
echo ""
echo "Usage:"
echo "debup add [-y] <owner/repo|url>         Install and track a GitHub deb package"
echo "  debup upgrade [-y]                    Check and upgrade all tracked packages"
echo "  debup list                            List all tracked packages"
echo "  debup remove <package_name>           Untrack (and optionally purge) a package"
;;
esac